# ---- LINE Messaging API（必須）----
# LINE Developers コンソール > チャネル基本設定
LINE_CHANNEL_SECRET=
# LINE Developers コンソール > Messaging API 設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Anthropic（必須）----
ANTHROPIC_API_KEY=
# 既定は claude-opus-5。コストを抑えたい場合は claude-sonnet-5 に変更できる
ANTHROPIC_MODEL=claude-opus-5
# 抽出は medium、実行案の立案は high を既定にしている
ANTHROPIC_EXTRACT_EFFORT=medium
ANTHROPIC_PLAN_EFFORT=high

# ---- Google スプレッドシート（必須）----
# タスク台帳にするスプレッドシートの ID（URL の /d/ と /edit の間）
SPREADSHEET_ID=
TASKS_SHEET_NAME=tasks
MESSAGES_SHEET_NAME=messages
ACTIONS_SHEET_NAME=actions
RECORDS_SHEET_NAME=records

# ---- Google カレンダー / Gmail（任意）----
# Gmail 送信や個人カレンダーへの書き込みに使うドメイン全体の委任の対象ユーザー
# 未設定なら Gmail アクションは実行時にエラーを返す
GOOGLE_IMPERSONATE_SUBJECT=
GOOGLE_CALENDAR_ID=primary

# ---- 動作設定 ----
TIMEZONE=Asia/Tokyo
# 未処理メッセージがこの件数溜まったら解析する
ANALYZE_MIN_MESSAGES=3
# 件数が足りなくても、この分数が経過したら解析する
ANALYZE_MAX_AGE_MINUTES=30
# 1 回の解析で読むメッセージの上限
ANALYZE_BATCH_SIZE=120
# 文脈として渡す処理済みメッセージの件数
CONTEXT_MESSAGES=40
# 期限の何時間前からリマインドするか
REMINDER_LEAD_HOURS=24
# 自動実行を許可するリスク上限: low / medium / high / none
# none にするとすべての操作が LINE 上の承認待ちになる
AUTO_EXECUTE_MAX_RISK=low
# 対象グループを絞る場合はカンマ区切りの groupId。空なら全グループ
ALLOWED_GROUP_IDS=
# 新規タスク検出時にグループへ通知するか
NOTIFY_ON_NEW_TASKS=true

# ---- 折衝記録の抽出 ----
# 会話から顧客折衝・パートナー打合せの記録を抽出するか
# 有効にすると解析1回あたりの Claude 呼び出しが1回増える
ENABLE_INTERACTION_EXTRACTION=false
# 記録抽出を行うグループを絞る（カンマ区切り）。空なら全グループ
# 顧客・パートナーの話が出るグループだけに絞ると無駄な呼び出しが減る
INTERACTION_GROUP_IDS=
# これ未満の確度の記録案は捨てる。基幹システムに入るので高めにしてある
INTERACTION_MIN_CONFIDENCE=0.6

# ---- 折衝記録の登録先（基幹システム）----
# sheets = records シートに溜めるだけ（基幹システムがまだ無い間はこれ）
# http   = 基幹システムの REST API へ送る
RECORD_SINK=sheets
# RECORD_SINK=http のときは必須。詳細は docs/core-system-api.md
CORE_BASE_URL=
CORE_CREATE_PATH=/api/interactions
# 空にすると相手先マスタの照合を行わない
CORE_SEARCH_PATH=/api/counterparties
CORE_SEARCH_QUERY_PARAM=q
CORE_SEARCH_ITEMS_PATH=items
CORE_SEARCH_ID_PATH=id
CORE_SEARCH_NAME_PATH=name
# 登録レスポンスから ID / URL を読む位置（ドット区切り）
CORE_ID_PATH=id
CORE_URL_PATH=url
CORE_AUTH_HEADER=Authorization
CORE_AUTH_VALUE=
CORE_TIMEOUT_MS=15000
# こちらのフィールド名 → 先方のフィールド名（違うものだけ書けばよい）
# 例: {"counterpartyName":"customer_name","occurredAt":"contacted_at"}
CORE_FIELD_MAP=

# ---- ジョブ認証 ----
# Cloud Scheduler から /jobs/* を叩くときの共有シークレット
JOB_SECRET=
